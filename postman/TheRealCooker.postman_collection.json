    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"userId\": \"testuser01\",\n  \"location\": { \"latitude\": 23.8103, \"longitude\": 90.4125 }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Self-registration. Requires email, password & confirmPassword (must match)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data?.accessToken) pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  if (res.data?.refreshToken) pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  if (res.data?._id) pm.collectionVariables.set('userId', res.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
